# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
# Get these values from: https://app.supabase.com → Settings → API

# Your Supabase project URL
# Format: https://[project-id].supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase publishable key (anon key)
# This is safe to expose in frontend code
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================

# API endpoint URL (optional)
# Use for custom API calls if needed
VITE_API_URL=http://localhost:3000

# Contact form email recipient
VITE_CONTACT_EMAIL=kdkinteh@yahoo.com

# ==============================================================================
# DEVELOPMENT SETTINGS
# ==============================================================================

# Enable debug logging (true/false)
DEBUG=false

# Node environment
NODE_ENV=development

# ==============================================================================
# NOTES:
# ==============================================================================
# 1. Copy this file to .env.local for local development
# 2. Never commit .env.local to Git (it's in .gitignore)
# 3. Add environment variables to Vercel Dashboard for production
# 4. Use VITE_ prefix for frontend environment variables (exposed to browser)
# 5. All VITE_ prefixed variables are visible in frontend code - don't put secrets here
# 6. For secrets, use serverless functions or server-side environment variables
